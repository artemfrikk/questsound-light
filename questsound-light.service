# Start QuestSound Light with the Raspberry Pi.
#   1. Unpack the archive to /home/pi/questsound-light and run it once by hand to pair:
#        cd /home/pi/questsound-light && ./node/bin/node questsound-light.mjs
#   2. sudo cp questsound-light.service /etc/systemd/system/
#      sudo systemctl enable --now questsound-light
#   3. Logs: journalctl -u questsound-light -f
# Change User and paths if your user is not "pi".
[Unit]
Description=QuestSound Light bridge
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/questsound-light
ExecStart=/home/pi/questsound-light/node/bin/node questsound-light.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/pi

[Install]
WantedBy=multi-user.target

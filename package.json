{
  "name": "questsound-light",
  "version": "0.2.0",
  "description": "Bridge between QuestSound (questsound.ru) and your smart lights: Home Assistant, Yeelight, Yandex, MQTT, WLED, webhooks. Desktop window and console versions.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "questsound-light": "questsound-light.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node questsound-light.mjs",
    "app": "electron .",
    "icons": "node build/make-icons.mjs",
    "dist": "electron-builder --publish never",
    "test": "node --test \"test/*.test.mjs\"",
    "dist:win": "electron-builder --win --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File build/pack-win.ps1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "main": "app/main.mjs",
  "author": "QuestSound <questsound.help@gmail.com>",
  "homepage": "https://github.com/artemfrikk/questsound-light",
  "build": {
    "appId": "ru.questsound.light",
    "productName": "QuestSound Light",
    "copyright": "MIT, QuestSound",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "lib/**",
      "modules/**",
      "package.json",
      "LICENSE"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "artifactName": "QuestSound-Light-mac-${arch}.zip"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "QuestSound-Light.AppImage"
    },
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  }
}